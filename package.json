{
  "name": "iobroker.go-e-wallbox",
  "version": "0.1.3",
  "description": "Lean device mirror for go-e Charger wallboxes: all relevant values of the official local HTTP API v2 as ioBroker states, readable and writable, without built-in charging logic",
  "author": {
    "name": "ben",
    "email": "go-e-wallbox@e-bin.de"
  },
  "homepage": "https://github.com/BenZ-ITS/ioBroker.go-e-wallbox",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "go-e",
    "go-eCharger",
    "wallbox",
    "ev charger",
    "energy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenZ-ITS/ioBroker.go-e-wallbox.git"
  },
  "bugs": {
    "url": "https://github.com/BenZ-ITS/ioBroker.go-e-wallbox/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "!build/**/*.test.js",
    "!build/**/*.map",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "test:unit": "npm run build && mocha \"build/**/*.test.js\"",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "npm run build && mocha test/integration.js --exit",
    "test": "npm run test:unit && npm run test:package",
    "release": "release-script",
    "release:check": "npm run build && node scripts/check-release.mjs",
    "translate": "translate-adapter translate && translate-adapter translate -a src -b src/i18n/en.json"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
}
